# Copy to .env.production on the Ubuntu host and chmod 0600.
# Never commit .env.production. Keep both channel switches false until a
# controlled draft-only acceptance test is approved.

# Release / public entrypoint
COMPOSE_PROJECT_NAME=geekdance-ai-ops-prod
ASSET_HOST_DIR=/var/lib/geekdance-ai-ops/assets
IMAGE_REPOSITORY=geekdance-ai-ops
IMAGE_TAG=initial
APP_DOMAIN=aiops.geekdance.cn
APP_ORIGIN=https://aiops.geekdance.cn
LETSENCRYPT_EMAIL=ops@example.com
EXPECTED_EGRESS_IPV4=203.0.113.10
TZ=Asia/Shanghai

# PostgreSQL. URL-encode reserved characters in DATABASE_URL.
POSTGRES_DB=geekdance_ops
POSTGRES_USER=geekdance_ops
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://geekdance_ops:replace-with-a-url-encoded-password@postgres:5432/geekdance_ops

# Redis
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-url-encoded-password@redis:6379

# Runtime queues and authentication
NODE_ENV=production
API_PORT=4000
TRUST_PROXY_HOPS=2
CONTENT_QUEUE_NAME=content-jobs
AUTOMATION_QUEUE_NAME=automation-jobs
IMAGE_QUEUE_NAME=image-jobs
CONTENT_ENGINE_MODE=openai
SESSION_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@geekdance.cn
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password

# OpenAI official API for research and article generation.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_FALLBACK_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_ALLOWED_HOSTS=api.openai.com,.openai.com,.oaistatic.com

# OpenRouter settings below are kept only as an explicit rollback path.
OPENROUTER_TEXT_API_KEY=
OPENROUTER_IMAGE_API_KEY=replace-with-image-api-key
OPENROUTER_API_KEY=
OPENROUTER_TEXT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_BASE_URL=https://openrouter.ai
OPENROUTER_TEXT_MODEL=qwen/qwen3.7-plus
OPENROUTER_TEXT_FALLBACK_MODELS=qwen/qwen3.5-plus-20260420,deepseek/deepseek-v4-pro
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
OPENROUTER_TEXT_TIMEOUT_MS=240000
OPENROUTER_IMAGE_ALLOWED_HOSTS=openrouter.ai,.openai.com,.oaistatic.com
IMAGE_PROVIDER_MODE=openai

# Company OSS
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_REGION=ap-southeast-1
OSS_BUCKET=replace-with-oss-bucket
OSS_PREFIX=ai-ops
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret

# GeekHome
GEEKHOME_MATERIAL_MCP_URL=https://home.geekdance.app/api/public/mcp/material
GEEKHOME_MATERIAL_TOKEN=replace-with-geekhome-token

# Official site draft adapter. Turning on live mode still requires both
# OFFICIAL_ALLOW_PROD=true and DEPLOY_CONFIRM_LIVE_DRAFTS=true.
OFFICIAL_BASE_URL=https://www.geekdance.cn
OFFICIAL_PUBLISHER_MODE=live
OFFICIAL_ADMIN_TOKEN=replace-with-draft-only-token
OFFICIAL_ADMIN_USERNAME=
OFFICIAL_ADMIN_PASSWORD=
OFFICIAL_ALLOW_PROD=true
OFFICIAL_UPLOAD_DIR=ai-generated/blogs
OFFICIAL_IMAGE_ALLOWED_HOSTS=home.geekdance.app,.aliyuncs.com,.geekdance.cn,aiops.geekdance.cn

# WeChat draft adapter. No mass-send or direct-publish API exists in this app.
WECHAT_PUBLISHER_MODE=live
WECHAT_ALLOW_PROD=true
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_AUTHOR=极客跳动编辑部
WECHAT_CONTENT_SOURCE_URL=https://www.geekdance.cn
WECHAT_IMAGE_ALLOWED_HOSTS=home.geekdance.app,.aliyuncs.com,.geekdance.cn,aiops.geekdance.cn
WECHAT_PROMO_BOARD_PATH=apps/web/public/brand/geekdance-promo-board.png

# Explicit deployment safety acknowledgement. Keep false for the first cloud
# boot. Set true only for a controlled draft-box acceptance test.
DEPLOY_CONFIRM_LIVE_DRAFTS=true

# Storage
ASSET_STORAGE_DIR=/data/assets
ASSET_PUBLIC_BASE_URL=https://aiops.geekdance.cn/api/public/assets
ASSET_PUBLIC_SECRET=replace-with-at-least-32-random-bytes
IMAGE_SERVICE_URL=http://image-worker:8000
GEEKDANCE_LOGO_PATH=apps/web/public/brand/geekdance-logo.png
GEEKDANCE_ARTICLE_ILLUSTRATION_LOGO_PATH=apps/web/public/brand/geekdance-article-illustration-logo.png

# Host-side encrypted backups
BACKUP_DIR=/var/backups/geekdance-ai-ops
BACKUP_ENCRYPTION_KEY_FILE=/etc/geekdance-ai-ops/backup.key
BACKUP_DAILY_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=28
BACKUP_MONTHLY_RETENTION_DAYS=183

# Optional monitoring webhook. Empty means log locally only.
ALERT_WEBHOOK_URL=
