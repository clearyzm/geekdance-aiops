# Runtime
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# PostgreSQL / Redis
# Docker Run all-in-one app connects to host services through host.docker.internal.
# If you run the Node services directly on the host, change these hosts to localhost.
POSTGRES_DB=geekdance_ops
POSTGRES_USER=geekdance_ops
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://geekdance_ops:replace-with-a-long-random-password@host.docker.internal:55432/geekdance_ops
REDIS_URL=redis://host.docker.internal:6379
CONTENT_QUEUE_NAME=content-jobs
AUTOMATION_QUEUE_NAME=automation-jobs
CONTENT_ENGINE_MODE=mock

# Authentication. Generate locally; never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@geekdance.cn
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password

# OpenAI official API for research and article writing.
# Set CONTENT_ENGINE_MODE=openai to enable these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_FALLBACK_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_ALLOWED_HOSTS=api.openai.com,.openai.com,.oaistatic.com

# OpenRouter values are retained only as an explicit rollback path.
OPENROUTER_TEXT_API_KEY=
OPENROUTER_IMAGE_API_KEY=
# Backward-compatible fallback when both tasks use one key.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_BASE_URL=https://openrouter.ai
OPENROUTER_TEXT_MODEL=qwen/qwen3.7-plus
OPENROUTER_TEXT_FALLBACK_MODELS=qwen/qwen3.5-plus-20260420,deepseek/deepseek-v4-pro
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
OPENROUTER_TEXT_TIMEOUT_MS=240000

# Company OSS
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_PREFIX=ai-ops
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# GeekHome
GEEKHOME_MATERIAL_MCP_URL=https://home.geekdance.app/api/public/mcp/material
GEEKHOME_MATERIAL_TOKEN=

# Official site: draft/media-only service account
OFFICIAL_BASE_URL=https://www.geekdance.cn
OFFICIAL_PUBLISHER_MODE=off
OFFICIAL_ADMIN_TOKEN=
OFFICIAL_ADMIN_USERNAME=
OFFICIAL_ADMIN_PASSWORD=
OFFICIAL_ALLOW_PROD=false
OFFICIAL_UPLOAD_DIR=ai-generated/blogs
OFFICIAL_IMAGE_ALLOWED_HOSTS=home.geekdance.app,.aliyuncs.com,.geekdance.cn,aiops.geekdance.cn

# WeChat Official Account: draft APIs only
WECHAT_PUBLISHER_MODE=off
WECHAT_ALLOW_PROD=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_AUTHOR=极客跳动编辑部
WECHAT_CONTENT_SOURCE_URL=https://www.geekdance.cn
WECHAT_IMAGE_ALLOWED_HOSTS=home.geekdance.app,.aliyuncs.com,.geekdance.cn,aiops.geekdance.cn
WECHAT_PROMO_BOARD_PATH=apps/web/public/brand/geekdance-promo-board.png

# Image workshop (use OpenAI in production; keep mock for first-run safety)
IMAGE_QUEUE_NAME=image-jobs
ASSET_STORAGE_DIR=/data/assets
ASSET_HOST_DIR=/var/lib/geekdance-ai-ops/assets
IMAGE_SERVICE_URL=http://127.0.0.1:8000
IMAGE_PROVIDER_MODE=mock
OPENROUTER_IMAGE_ALLOWED_HOSTS=openrouter.ai,.openai.com,.oaistatic.com
ASSET_PUBLIC_BASE_URL=http://localhost:3000/api/public/assets
ASSET_PUBLIC_SECRET=replace-with-at-least-32-random-bytes
GEEKDANCE_LOGO_PATH=apps/web/public/brand/geekdance-logo.png
GEEKDANCE_ARTICLE_ILLUSTRATION_LOGO_PATH=apps/web/public/brand/geekdance-article-illustration-logo.png
